@page "/example"
@page "/example/{Greeting}"
@rendermode InteractiveServer

<PageTitle>Example Page</PageTitle>

<h1>Example page</h1>

<p>@Message</p>

<p>Welcome, dear @Greeting!</p>

<Counter count="0" />

@code {
    [Parameter] public string? Greeting { get; set; }

    private string Message { get; set; } = "Hello, Blazor!";
}