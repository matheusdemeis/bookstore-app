@page "/books/details"
@using Microsoft.EntityFrameworkCore
@using Bookstore.Models
@inject IDbContextFactory<Bookstore.Data.BookstoreDb> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Bookstore - Details @(book?.Title ?? "Loading...")</PageTitle>

<div class="container py-4">
    @if (book is null)
    {
        <div class="text-center py-5">
            <p class="fs-5 text-muted mb-0">Loading...</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="row g-4 align-items-start">
                    <div class="col-12 col-md-4">
                        <img src="@book.CoverImageUrl"
                             alt="@book.Title"
                             class="img-fluid rounded w-100"
                             style="max-height: 500px; object-fit: cover;" />
                    </div>

                    <div class="col-12 col-md-8">
                        <h1 class="mb-3">@book.Title</h1>
                        <p class="text-muted mb-4">by @book.Author</p>

                        <dl class="row mb-4">
                            <dt class="col-sm-4">Genre</dt>
                            <dd class="col-sm-8">@book.Genre</dd>

                            <dt class="col-sm-4">Publisher</dt>
                            <dd class="col-sm-8">@book.Publisher</dd>

                            <dt class="col-sm-4">Publication Year</dt>
                            <dd class="col-sm-8">@book.PublicationYear</dd>

                            <dt class="col-sm-4">Language</dt>
                            <dd class="col-sm-8">@book.Language</dd>

                            <dt class="col-sm-4">Page Count</dt>
                            <dd class="col-sm-8">@book.PageCount</dd>

                            <dt class="col-sm-4">Price</dt>
                            <dd class="col-sm-8">$@book.Price</dd>
                        </dl>

                        <div class="d-flex flex-wrap gap-2">
                            <a href="@($"/books/edit?id={book.Id}")" class="btn btn-outline-primary">
                                Edit
                            </a>
                            <a href="/" class="btn btn-outline-secondary">
                                Back to List
                            </a>
                            <button class="btn btn-warning"
                                    @onclick="PurchaseBookAsync"
                                    disabled="@isPurchasing">
                                @(isPurchasing ? "Purchasing..." : "Purchase")
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(purchaseMessage))
                        {
                            <p class="mt-3 mb-0 text-success">@purchaseMessage</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(purchaseError))
                        {
                            <p class="mt-3 mb-0 text-danger">@purchaseError</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Book? book;
    private bool isPurchasing;
    private string? purchaseMessage;
    private string? purchaseError;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        book = await context.Books.FirstOrDefaultAsync(m => m.Id == Id);

        if (book is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task PurchaseBookAsync()
    {
        if (book is null || isPurchasing)
        {
            return;
        }

        isPurchasing = true;
        purchaseMessage = null;
        purchaseError = null;

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var selectedBook = await context.Books.FirstOrDefaultAsync(b => b.Id == book.Id);

            if (selectedBook is null)
            {
                purchaseError = "This book could not be found.";
                return;
            }

            var order = new Order
            {
                OrderDate = DateTime.UtcNow,
                OrderItems = new List<OrderItem>
                {
                    new()
                    {
                        Book = selectedBook,
                        Quantity = 1
                    }
                }
            };

            context.Orders.Add(order);
            await context.SaveChangesAsync();

            purchaseMessage = "Order placed successfully.";
            NavigationManager.NavigateTo("/myorders");
        }
        catch
        {
            purchaseError = "Unable to place your order right now.";
        }
        finally
        {
            isPurchasing = false;
        }
    }
}
